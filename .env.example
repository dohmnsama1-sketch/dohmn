# PayPal Developer Dashboard: create an app in Sandbox and paste its credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local demo origin. PayPal return/cancel links and browser origin checks use it.
MENDCART_PUBLIC_URL=http://127.0.0.1:8000
MENDCART_HOST=127.0.0.1
PORT=8000

# Optional OpenAI-compatible structured-output model. Demo works without it.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
